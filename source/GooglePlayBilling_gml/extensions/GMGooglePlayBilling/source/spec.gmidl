// =============================================================================
// Callback-specific payload records
// =============================================================================

/// Delivered as the second callback argument of play_billing_query_product_details_async,
/// alongside the GooglePlayBillingResult - mirrors QueryProductDetailsResult's own two fields.
[global]
class `[[GooglePlayBillingProductDetailsQueryResult]]` prototype Object
{
    [field, type_hint = `GooglePlayBillingProductDetails[]`]
    property products : gmval { get; set; }
    [field, type_hint = `GooglePlayBillingUnfetchedProduct[]`]
    property unfetched_products : gmval { get; set; }
}

/// Delivered as the second (optional) callback argument of both
/// play_billing_create_alternative_billing_only_reporting_details_async and
/// play_billing_create_billing_program_reporting_details_async.
[global]
class `[[GooglePlayBillingReportingDetails]]` prototype Object
{
    /// Absent on the alternative-billing-only reporting path (that program has no
    /// BillingProgram ordinal of its own - see enable_alternative_billing_only).
    [field, type_hint = `GooglePlayBillingProgram?`]
    property billing_program : gmval { get; set; }
    [field] property external_transaction_token : string { get; set; }
}

[global]
class `[[GooglePlayBillingChoiceAvailabilityDetails]]` prototype Object
{
    [field, type_hint = `GooglePlayBillingChoiceScreenType`]
    property choice_screen_type : int32 { get; set; }
    [field] property external_link_available : bool { get; set; }
}

/// Delivered as the second (optional) callback argument of
/// play_billing_is_billing_program_available_async.
[global]
class `[[GooglePlayBillingProgramAvailabilityDetails]]` prototype Object
{
    [field, type_hint = `GooglePlayBillingProgram`]
    property billing_program : int32 { get; set; }
    [field, type_hint = `GooglePlayBillingChoiceAvailabilityDetails?`]
    property billing_choice_details : gmval { get; set; }
}

/// Delivered as the sole callback argument of play_billing_show_in_app_messages -
/// its own code system (InAppMessageResult.responseCode), unrelated to GooglePlayBillingResponseCode.
[global]
class `[[GooglePlayBillingInAppMessageResult]]` prototype Object
{
    [field, type_hint = `GooglePlayBillingInAppMessageResponseCode`]
    property response_code : int32 { get; set; }
    [field, type_hint = `string?`]
    property purchase_token : gmval { get; set; }
}

/// Delivered as the second (optional) callback argument of
/// play_billing_get_billing_choice_info_async.
[global]
class `[[GooglePlayBillingChoiceInfo]]` prototype Object
{
    [field, type_hint = `string?`]
    property billing_choice_image_url : gmval { get; set; }
    [field, type_hint = `string?`]
    property loyalty_info : gmval { get; set; }
}

[global]
class `[[GooglePlayBillingExternalLinkLaunchOptions]]` prototype Object
{
    [field, type_hint = `GooglePlayBillingProgram`]
    property billing_program : int32 { get; set; }
}

// =============================================================================
// Init / connection
// =============================================================================

/// callback(billing_result: GooglePlayBillingResult, purchases: GooglePlayBillingPurchase[])
/// fires whenever purchases update. purchases is always a real (possibly empty) array.
[global, bind = typed_gml]
function play_billing_init(
    [type_hint = `GooglePlayBillingInitOptions?`] options: gmval,
    callback: func
): unit;

/// callback_start(billing_result: GooglePlayBillingResult).
/// callback_disconnect() - no arguments, mirrors onBillingServiceDisconnected() exactly.
[global, bind = typed_gml]
function play_billing_start_connection(callback_start: func, callback_disconnect: func): unit;

[global, bind = typed_gml]
function play_billing_end_connection(): unit;

[global, bind = typed_gml, type_hint = `GooglePlayBillingConnectionState`]
function play_billing_get_connection_state(): int32;

[global, bind = typed_gml]
function play_billing_is_ready(): bool;

// =============================================================================
// Config / availability / feature support
// =============================================================================

/// callback(billing_result: GooglePlayBillingResult, config: GooglePlayBillingConfig?) -
/// config is absent (undefined) whenever Google didn't deliver one, including on failure.
[global, bind = typed_gml]
function play_billing_get_config_async(callback: func): unit;

/// callback(billing_result: GooglePlayBillingResult).
[global, bind = typed_gml]
function play_billing_is_alternative_billing_only_available_async(callback: func): unit;

/// callback(billing_result: GooglePlayBillingResult, availability_details: GooglePlayBillingProgramAvailabilityDetails?) -
/// availability_details is absent (undefined) only when the request never reached Google
/// (e.g. BillingClient not ready); never fabricated.
[global, bind = typed_gml]
function play_billing_is_billing_program_available_async(
    [type_hint = `GooglePlayBillingProgram`] program: int32,
    callback: func
): unit;

[global, bind = typed_gml, type_hint = `GooglePlayBillingResult`]
function play_billing_is_feature_supported(
    [type_hint = `GooglePlayBillingFeatureType`] feature: int32
): gmval;

// =============================================================================
// Products
// =============================================================================

/// callback(billing_result: GooglePlayBillingResult, query_result: GooglePlayBillingProductDetailsQueryResult) -
/// query_result is always present (its products/unfetched_products arrays are simply empty on failure),
/// mirroring queryProductDetailsAsync's own (BillingResult, QueryProductDetailsResult) listener shape.
[global, bind = typed_gml]
function play_billing_query_product_details_async(
    [type_hint = `GooglePlayBillingProductInput[]`] products: gmval,
    callback: func
): unit;

/// Clears the native ProductDetails cache used by play_billing_launch_billing_flow.
[global, bind = typed_gml]
function play_billing_clear_products(): unit;

// =============================================================================
// Billing flow
// =============================================================================

/// Launches one or more products using ProductDetails cached by the query function.
/// Supports single purchases, bundles (multiple one-time products), and subscriptions with add-ons.
/// Each item can specify its own offer token and subscription replacement parameters.
/// Always returns the complete GooglePlayBillingResult instead of a Boolean.
[global, bind = typed_gml, type_hint = `GooglePlayBillingResult`]
function play_billing_launch_billing_flow(
    [type_hint = `GooglePlayBillingProductDetailsParams[]`] items: gmval,
    [type_hint = `GooglePlayBillingFlowOptions?`] options: gmval
): gmval;

// =============================================================================
// Purchases
// =============================================================================

/// callback(billing_result: GooglePlayBillingResult, purchases: GooglePlayBillingPurchase[]).
[global, bind = typed_gml]
function play_billing_query_purchases_async(
    [type_hint = `GooglePlayBillingProductType`] product_type: int32,
    include_suspended_subscriptions: bool,
    callback: func
): unit;

/// callback(billing_result: GooglePlayBillingResult).
[global, bind = typed_gml]
function play_billing_acknowledge_purchase(purchase_token: string, callback: func): unit;

/// callback(billing_result: GooglePlayBillingResult, purchase_token: string) -
/// purchase_token is always the same token passed to this function, echoed back,
/// mirroring ConsumeResponseListener's own (BillingResult, String) signature exactly.
[global, bind = typed_gml]
function play_billing_consume_async(purchase_token: string, callback: func): unit;

// =============================================================================
// Alternative billing / billing programs
// =============================================================================

/// callback(billing_result: GooglePlayBillingResult, reporting_details: GooglePlayBillingReportingDetails?) -
/// reporting_details is absent (undefined) on failure.
[global, bind = typed_gml]
function play_billing_create_alternative_billing_only_reporting_details_async(callback: func): unit;

/// Replaces the deprecated createExternalOfferReportingDetailsAsync API.
/// callback(billing_result: GooglePlayBillingResult, reporting_details: GooglePlayBillingReportingDetails?) -
/// reporting_details is absent (undefined) on failure.
[global, bind = typed_gml]
function play_billing_create_billing_program_reporting_details_async(
    [type_hint = `GooglePlayBillingProgram`] program: int32,
    callback: func
): unit;

// =============================================================================
// In-app messages
// =============================================================================

/// Returns the immediate BillingResult from showInAppMessages.
/// When omitted, all message categories are shown (default behavior).
/// callback(in_app_message_result: GooglePlayBillingInAppMessageResult) when the flow finishes -
/// its own single-argument wrapper, matching InAppMessageResponseListener's own single-param signature.
[global, bind = typed_gml, type_hint = `GooglePlayBillingResult`]
function play_billing_show_in_app_messages(
    [type_hint = `GooglePlayBillingInAppMessageOptions?`] options: gmval,
    callback: func
): gmval;

// =============================================================================
// Billing Choice (Billing 9.1+)
// =============================================================================

/// callback(billing_result: GooglePlayBillingResult, choice_info: GooglePlayBillingChoiceInfo?) -
/// choice_info is absent (undefined) on failure.
[global, bind = typed_gml]
function play_billing_get_billing_choice_info_async(callback: func): unit;

/// Launches the Play Billing system UI to show the information dialog for a billing program.
/// callback(billing_result: GooglePlayBillingResult) when the dialog dismisses.
[global, bind = typed_gml]
function play_billing_show_billing_program_information_dialog(
    [type_hint = `GooglePlayBillingProgram`] program: int32,
    callback: func
): unit;

/// Launches the Play Billing system UI to show the alternative billing information dialog.
/// callback(billing_result: GooglePlayBillingResult) when the dialog dismisses.
[global, bind = typed_gml]
function play_billing_show_alternative_billing_only_information_dialog(callback: func): unit;

/// Launches the external link associated with a billing program.
/// callback(billing_result: GooglePlayBillingResult) when the flow completes or is dismissed.
[global, bind = typed_gml]
function play_billing_launch_external_link(
    [type_hint = `GooglePlayBillingExternalLinkLaunchOptions`] options: gmval,
    callback: func
): unit;
