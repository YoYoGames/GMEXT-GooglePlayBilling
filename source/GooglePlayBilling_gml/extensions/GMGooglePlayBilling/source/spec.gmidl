[gml_api]
module GMGooglePlayBilling;

// =============================================================================
// Enums — Google Play Billing 9.1.0
// =============================================================================

/// Product category used by product and purchase queries.
/// Kotlin maps these values to BillingClient.ProductType constants.
[global, bind = typed_gml]
enum GooglePlayBillingProductType : int32
{
    InApp = 0,
    Subscription = 1,
    Unknown = 2,
}

/// Feature queried by play_billing_is_feature_supported.
/// Kotlin maps these values to BillingClient.FeatureType constants.
[global, bind = typed_gml]
enum GooglePlayBillingFeatureType : int32
{
    AlternativeBillingOnly = 0,
    BillingConfig = 1,
    ExternalOffer = 2,
    IncludeSuspendedSubscriptions = 3,
    InAppMessaging = 4,
    PriceChangeConfirmation = 5,
    ProductDetails = 6,
    Subscriptions = 7,
    SubscriptionsUpdate = 8,
}

/// Billing programs supported by BillingClient.Builder.enableBillingProgram.
[global, bind = typed_gml]
enum GooglePlayBillingProgram : int32
{
    Unspecified = 0,
    ExternalContentLink = 1,
    ExternalOffer = 3,
    ExternalPayments = 4,
    BillingChoice = 5,
}

[global, bind = typed_gml]
enum GooglePlayBillingResponseCode : int32
{
    /// Deprecated by Google; ServiceUnavailable is returned instead in modern clients.
    ServiceTimeout = -3,
    FeatureNotSupported = -2,
    ServiceDisconnected = -1,
    Ok = 0,
    UserCanceled = 1,
    ServiceUnavailable = 2,
    BillingUnavailable = 3,
    ItemUnavailable = 4,
    DeveloperError = 5,
    Error = 6,
    ItemAlreadyOwned = 7,
    ItemNotOwned = 8,
    NetworkError = 12,
}

[global, bind = typed_gml]
enum GooglePlayBillingPurchasesUpdatedSubResponseCode : int32
{
    None = 0,
    PaymentDeclinedDueToInsufficientFunds = 1,
    UserIneligible = 2,
}

[global, bind = typed_gml]
enum GooglePlayBillingPurchaseState : int32
{
    UnspecifiedState = 0,
    Purchased = 1,
    Pending = 2,
}

/// BillingFlowParams.ProductDetailsParams.SubscriptionProductReplacementParams.ReplacementMode.
[global, bind = typed_gml]
enum GooglePlayBillingSubscriptionReplacementMode : int32
{
    UnknownReplacementMode = 0,
    WithTimeProration = 1,
    ChargeProratedPrice = 2,
    WithoutProration = 3,
    ChargeFullPrice = 4,
    Deferred = 5,
    KeepExisting = 6,
}

[global, bind = typed_gml]
enum GooglePlayBillingConnectionState : int32
{
    Disconnected = 0,
    Connecting = 1,
    Connected = 2,
    Closed = 3,
}

[global, bind = typed_gml]
enum GooglePlayBillingRecurrenceMode : int32
{
    Unknown = 0,
    InfiniteRecurring = 1,
    FiniteRecurring = 2,
    NonRecurring = 3,
}

[global, bind = typed_gml]
enum GooglePlayBillingUnfetchedProductStatus : int32
{
    Unknown = 0,
    InvalidProductIdFormat = 2,
    ProductNotFound = 3,
    NoEligibleOffer = 4,
}

[global, bind = typed_gml]
enum GooglePlayBillingInAppMessageResponseCode : int32
{
    NoActionNeeded = 0,
    SubscriptionStatusUpdated = 1,
}

[global, bind = typed_gml]
enum GooglePlayBillingChoiceScreenType : int32
{
    Unspecified = 0,
    DeveloperRendered = 1,
    GoogleRendered = 2,
}

[global, bind = typed_gml]
enum GooglePlayBillingInAppMessageCategory : int32
{
    Unknown = 0,
    SubscriptionUpdate = 1,
    PriceChange = 2,
}

// =============================================================================
// Input records
// =============================================================================

/// Options used when creating BillingClient.
/// One-time purchases (pending purchases) are always enabled for Billing 9.1+ support.
/// enable_prepaid_plans enables pending transactions for prepaid subscriptions.
/// Billing-program flags must only be enabled when the application is eligible
/// and configured for the corresponding Google Play billing program.
/// Explicit Boolean fields are used instead of an enum array because generated
/// GMIDL enum-array accessors are Java enum objects, while BillingClient.Builder
/// expects integer BillingProgram constants.
[global]
class `[[GooglePlayBillingInitOptions]]` prototype Object
{
    /// Optional. Defaults to false when omitted.
    [field, type_hint = `bool?`]
    property enable_auto_service_reconnection : gmval { get; set; }

    /// Optional. Defaults to false when omitted.
    [field, type_hint = `bool?`]
    property enable_prepaid_plans : gmval { get; set; }

    /// Optional. Defaults to false when omitted.
    [field, type_hint = `bool?`]
    property enable_alternative_billing_only : gmval { get; set; }

    /// Optional. Defaults to false when omitted.
    [field, type_hint = `bool?`]
    property enable_external_content_link : gmval { get; set; }

    /// Optional. Defaults to false when omitted.
    [field, type_hint = `bool?`]
    property enable_external_offer : gmval { get; set; }

    /// Optional. Defaults to false when omitted.
    [field, type_hint = `bool?`]
    property enable_external_payments : gmval { get; set; }

    /// Optional. Defaults to false when omitted.
    [field, type_hint = `bool?`]
    property enable_billing_choice : gmval { get; set; }
}

/// Product entry passed to play_billing_query_product_details_async.
[global]
class `[[GooglePlayBillingProductInput]]` prototype Object
{
    [field] property product_id : string { get; set; }
    [field, type_hint = `GooglePlayBillingProductType`]
    property product_type : int32 { get; set; }
    /// Optional. Dynamic product token for querying dynamic products (Billing 9.1+).
    [field, type_hint = `string?`]
    property dynamic_product_token : gmval { get; set; }
}

/// Parameters for replacing an existing subscription product.
[global]
class `[[GooglePlayBillingSubscriptionUpdateParams]]` prototype Object
{
    /// Required when subscription_update_params is supplied.
    [field] property old_purchase_token : string { get; set; }

    /// Required when subscription_update_params is supplied.
    [field] property old_product_id : string { get; set; }

    /// Required when subscription_update_params is supplied.
    [field, type_hint = `GooglePlayBillingSubscriptionReplacementMode`]
    property replacement_mode : int32 { get; set; }

    /// Optional. Supply only when the originating subscription transaction
    /// was processed through alternative billing.
    [field, type_hint = `string?`]
    property original_external_transaction_id : gmval { get; set; }
}

/// Item in a multi-product billing flow (bundles, subscriptions with add-ons).
[global]
class `[[GooglePlayBillingProductDetailsParams]]` prototype Object
{
    /// Required. Product ID to purchase.
    [field] property product_id : string { get; set; }

    /// Optional. Offer token for the product. When omitted, uses default offer.
    [field, type_hint = `string?`]
    property offer_token : gmval { get; set; }

    /// Optional. Subscription replacement parameters. Only for subscription upgrades/downgrades.
    [field, type_hint = `GooglePlayBillingSubscriptionUpdateParams?`]
    property subscription_replacement : gmval { get; set; }
}

/// Options for play_billing_launch_billing_flow.
/// Every property is optional. Kotlin applies only properties that are present.
[global]
class `[[GooglePlayBillingFlowOptions]]` prototype Object
{
    /// Optional. When omitted, BillingFlowParams keeps the SDK default.
    [field, type_hint = `bool?`]
    property is_offer_personalized : gmval { get; set; }

    /// Optional. Must not contain PII and must not exceed 64 characters.
    [field, type_hint = `string?`]
    property obfuscated_account_id : gmval { get; set; }

    /// Optional. Must not contain PII and must not exceed 64 characters.
    [field, type_hint = `string?`]
    property obfuscated_profile_id : gmval { get; set; }
}

/// Options for play_billing_show_in_app_messages.
[global]
class `[[GooglePlayBillingInAppMessageOptions]]` prototype Object
{
    /// Optional. Message category codes to show. When omitted, shows all categories.
    /// Category codes: 0=Unknown, 1=SubscriptionUpdate, 2=PriceChange
    /// If empty array is supplied, no messages are shown.
    [field, type_hint = `GooglePlayBillingInAppMessageCategory[]`]
    property categories : gmval { get; set; }
}

